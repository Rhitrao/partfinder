# Copy this file to .dev.vars for `npx wrangler dev`, and put the real values there.
# .dev.vars is in .gitignore and must stay there: these are secrets, and secrets never go in the
# repo. In Cloudflare the same two names are Worker secrets, set with `wrangler secret put`.

# A Google Maps key restricted to Places API (New).
GOOGLE_PLACES_KEY="replace-me-places-api-new-key"

# The shared passcode for /parts/vendors. Changing it signs every browser out.
VENDOR_PASSCODE="replace-me-passcode"
